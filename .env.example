# ← این فایل را به «.env» کپی کن و یکی از دو کلید را پر کن (cp .env.example .env)

# ── گزینه ۱: Resend (ساده‌ترین — فقط برای فرستادن به ایمیل خودت) ──
# resend.com → Sign up با جی‌میلت → API Keys → Create → کلید را اینجا بگذار
RESEND_API_KEY=

# ── گزینه ۲: Brevo (۳۰۰ ایمیل رایگان در روز — می‌تواند به هر کسی بفرستد) ──
# brevo.com → ثبت‌نام → تأیید ایمیل فرستنده → SMTP & API → API Keys
BREVO_API_KEY=

# فرستنده (اختیاری — پیش‌فرض برای Resend خودکار است)
MAIL_FROM=

# ── گزینه ۳: SMTP جی‌میل (روی هاست‌های محدودشده کار نمی‌کند) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1
